generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id           String       @id @default(cuid())
  youtubeId    String
  url          String
  title        String?
  channel      String?
  thumbnail    String?
  durationSec  Int?
  language     String?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  generations  Generation[]

  @@index([youtubeId])
  @@index([createdAt])
}

model Generation {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  provider     String     // "anthropic" | "google" | "openai"
  model        String
  byok         Boolean    @default(false)
  promptTokens Int?
  outputTokens Int?
  latencyMs    Int?
  clips        Json       // ViralClip[]
  createdAt    DateTime   @default(now())

  exports      ExportEvent[]

  @@index([submissionId])
  @@index([createdAt])
}

model ExportEvent {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  format       String     // "capcut" | "premiere" | "fcpx" | "srt" | "vtt" | "txt" | "json"
  clipIndex    Int?
  createdAt    DateTime   @default(now())

  @@index([generationId])
}
